  <!-- TOAST -->
  <div class="toast" id="toast"></div>

  <script>
  (() => {
    'use strict';

    // ===========================================================
    // STORAGE
    // ===========================================================
    const STORAGE_KEY = 'catch-contacts-v1';
    const EVENT_KEY = 'catch-event-name';

    let contacts = [];
    let currentFilter = 'all';
    let editingId = null;
    let currentTag = '';
    let currentPhoto = null;

    function loadContacts() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        contacts = raw ? JSON.parse(raw) : [];
      } catch (e) {
        contacts = [];
      }
    }

    function saveContacts() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(contacts));
      } catch (e) {
        toast('Storage full — try Export then Clear');
      }
    }

    function uid() {
      return 'c_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
    }

    // ===========================================================
    // TOAST
    // ===========================================================
    function toast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      clearTimeout(t._timer);
      t._timer = setTimeout(() => t.classList.remove('show'), 2500);
    }

    // ===========================================================
    // VIEWS
    // ===========================================================
    function switchView(name) {
      document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
      document.getElementById('view-' + name).classList.add('active');
      document.querySelectorAll('.tabbar button').forEach(b => {
        b.classList.toggle('active', b.dataset.view === name);
      });
      if (name === 'list') renderList();
      if (name === 'export') renderStats();
      if (name === 'capture') renderCapture();
    }

    document.querySelectorAll('.tabbar button').forEach(b => {
      b.addEventListener('click', () => switchView(b.dataset.view));
    });

    // ===========================================================
    // CAPTURE VIEW
    // ===========================================================
    function renderCapture() {
      const n = contacts.length;
      document.getElementById('hero-count').textContent = n;
      document.getElementById('hero-plural').textContent = n === 1 ? '' : 's';

      const wrap = document.getElementById('last-capture-wrap');
      if (n === 0) {
        wrap.innerHTML = '';
        return;
      }
      const last = contacts[contacts.length - 1];
      const fullName = ((last.firstName || '') + ' ' + (last.lastName || '')).trim() || '(unnamed)';
      wrap.innerHTML = `
        <div class="last-capture">
          <div style="flex: 1;">
            <div class="last-capture__label">Last captured</div>
            <div class="last-capture__name">${escapeHTML(fullName)}</div>
            ${last.company ? `<div class="last-capture__company">${escapeHTML(last.company)}</div>` : ''}
          </div>
          <button class="last-capture__edit" data-edit-id="${last.id}">Edit</button>
        </div>
      `;
      wrap.querySelector('[data-edit-id]')?.addEventListener('click', (e) => {
        openForm(e.currentTarget.dataset.editId);
      });
    }

    document.getElementById('btn-photo').addEventListener('click', () => {
      openForm(null, { triggerPhoto: true });
    });
    document.getElementById('btn-manual').addEventListener('click', () => {
      openForm(null);
    });

    // ===========================================================
    // FORM MODAL
    // ===========================================================
    const modal = document.getElementById('form-modal');
    const form = document.getElementById('contact-form');

    function openForm(id, opts = {}) {
      editingId = id;
      currentTag = '';
      currentPhoto = null;

      // Reset form
      form.reset();
      document.getElementById('f-id').value = '';
      document.querySelectorAll('.tag-btn').forEach(b => b.dataset.active = 'false');
      document.getElementById('photo-preview').style.display = 'none';
      document.getElementById('photo-placeholder').style.display = 'block';
      document.getElementById('photo-remove').style.display = 'none';
      document.getElementById('photo-zone').classList.remove('photo-zone--has-photo');

      if (id) {
        // Edit mode
        const c = contacts.find(c => c.id === id);
        if (!c) return;
        document.getElementById('modal-title').textContent = 'Edit contact';
        document.getElementById('modal-sub').textContent = 'Update what you know now.';
        document.getElementById('f-id').value = c.id;
        document.getElementById('f-first').value = c.firstName || '';
        document.getElementById('f-last').value = c.lastName || '';
        document.getElementById('f-company').value = c.company || '';
        document.getElementById('f-role').value = c.role || '';
        document.getElementById('f-context').value = c.context || '';
        document.getElementById('f-hook').value = c.hook || '';
        document.getElementById('f-email').value = c.email || '';
        document.getElementById('f-phone').value = c.phone || '';
        document.getElementById('f-linkedin').value = c.linkedin || '';
        if (c.tag) {
          currentTag = c.tag;
          document.querySelector(`.tag-btn[data-tag="${c.tag}"]`).dataset.active = 'true';
        }
        if (c.photo) {
          currentPhoto = c.photo;
          document.getElementById('photo-preview').src = c.photo;
          document.getElementById('photo-preview').style.display = 'block';
          document.getElementById('photo-placeholder').style.display = 'none';
          document.getElementById('photo-remove').style.display = 'grid';
          document.getElementById('photo-zone').classList.add('photo-zone--has-photo');
        }
        document.getElementById('form-delete').style.display = 'block';
      } else {
        document.getElementById('modal-title').textContent = 'New contact';
        document.getElementById('modal-sub').textContent = 'Just the essentials. Complete later.';
        document.getElementById('form-delete').style.display = 'none';
      }

      modal.classList.add('active');

      // Auto-trigger photo capture if needed
      if (opts.triggerPhoto) {
        setTimeout(() => {
          document.getElementById('f-photo-input').click();
        }, 250);
      } else {
        setTimeout(() => {
          document.getElementById('f-first').focus();
        }, 250);
      }
    }

    function closeForm() {
      modal.classList.remove('active');
      editingId = null;
      currentTag = '';
      currentPhoto = null;
    }

    document.getElementById('form-cancel').addEventListener('click', closeForm);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeForm();
    });

    // Tag selector
    document.querySelectorAll('.tag-btn').forEach(b => {
      b.addEventListener('click', () => {
        const tag = b.dataset.tag;
        if (currentTag === tag) {
          // Toggle off
          currentTag = '';
          b.dataset.active = 'false';
        } else {
          document.querySelectorAll('.tag-btn').forEach(x => x.dataset.active = 'false');
          currentTag = tag;
          b.dataset.active = 'true';
        }
      });
    });

    // Photo handling
    const photoInput = document.getElementById('f-photo-input');
    photoInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      try {
        const dataUrl = await compressImage(file, 1200, 0.75);
        currentPhoto = dataUrl;
        document.getElementById('photo-preview').src = dataUrl;
        document.getElementById('photo-preview').style.display = 'block';
        document.getElementById('photo-placeholder').style.display = 'none';
        document.getElementById('photo-remove').style.display = 'grid';
        document.getElementById('photo-zone').classList.add('photo-zone--has-photo');
      } catch (err) {
        toast('Photo error');
      }
    });

    document.getElementById('photo-remove').addEventListener('click', (e) => {
      e.stopPropagation();
      e.preventDefault();
      currentPhoto = null;
      photoInput.value = '';
      document.getElementById('photo-preview').style.display = 'none';
      document.getElementById('photo-placeholder').style.display = 'block';
      document.getElementById('photo-remove').style.display = 'none';
      document.getElementById('photo-zone').classList.remove('photo-zone--has-photo');
    });

    function compressImage(file, maxSize, quality) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            let w = img.width, h = img.height;
            if (w > h && w > maxSize) {
              h = h * (maxSize / w);
              w = maxSize;
            } else if (h > maxSize) {
              w = w * (maxSize / h);
              h = maxSize;
            }
            const canvas = document.createElement('canvas');
            canvas.width = w; canvas.height = h;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, w, h);
            resolve(canvas.toDataURL('image/jpeg', quality));
          };
          img.onerror = reject;
          img.src = e.target.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    // Form submit
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const firstName = document.getElementById('f-first').value.trim();
      if (!firstName) {
        toast('First name required');
        return;
      }

      const data = {
        id: editingId || uid(),
        firstName,
        lastName: document.getElementById('f-last').value.trim(),
        company: document.getElementById('f-company').value.trim(),
        role: document.getElementById('f-role').value.trim(),
        tag: currentTag,
        context: document.getElementById('f-context').value.trim(),
        hook: document.getElementById('f-hook').value.trim(),
        email: document.getElementById('f-email').value.trim(),
        phone: document.getElementById('f-phone').value.trim(),
        linkedin: document.getElementById('f-linkedin').value.trim(),
        photo: currentPhoto,
        createdAt: editingId ? (contacts.find(c => c.id === editingId)?.createdAt || Date.now()) : Date.now(),
        updatedAt: Date.now(),
      };

      if (editingId) {
        contacts = contacts.map(c => c.id === editingId ? data : c);
        toast('Saved');
      } else {
        contacts.push(data);
        toast('Captured');
      }
      saveContacts();
      closeForm();
      renderCapture();
    });

    document.getElementById('form-delete').addEventListener('click', () => {
      if (!editingId) return;
      if (!confirm('Delete this contact?')) return;
      contacts = contacts.filter(c => c.id !== editingId);
      saveContacts();
      closeForm();
      renderCapture();
      renderList();
      toast('Deleted');
    });

    // ===========================================================
    // LIST VIEW
    // ===========================================================
    function renderList() {
      const list = document.getElementById('contact-list');
      const filtered = currentFilter === 'all'
        ? contacts
        : contacts.filter(c => c.tag === currentFilter);

      document.getElementById('list-count').textContent = filtered.length;

      if (filtered.length === 0) {
        list.innerHTML = `
          <div class="empty-state">
            <div class="empty-state__title">Nothing yet.</div>
            <div class="empty-state__sub">${currentFilter === 'all' ? 'Capture your first contact' : 'No matches'}</div>
          </div>
        `;
        return;
      }

      // Sort by most recent first
      const sorted = [...filtered].sort((a, b) => b.createdAt - a.createdAt);

      list.innerHTML = sorted.map(c => {
        const fullName = ((c.firstName || '') + ' ' + (c.lastName || '')).trim() || '(unnamed)';
        const tagLetter = c.tag || '·';
        const company = [c.company, c.role].filter(Boolean).join(' · ');
        const metaItems = [];
        if (c.photo) metaItems.push('<span class="contact-card__meta-item"><span class="contact-card__dot"></span>Card</span>');
        if (c.email) metaItems.push('<span class="contact-card__meta-item">@</span>');
        if (c.linkedin) metaItems.push('<span class="contact-card__meta-item">in</span>');
        if (c.phone) metaItems.push('<span class="contact-card__meta-item">tel</span>');
        return `
          <div class="contact-card" data-id="${c.id}">
            <div class="contact-card__tag" data-tag="${c.tag || ''}">${escapeHTML(tagLetter)}</div>
            <div class="contact-card__body">
              <div class="contact-card__name">${escapeHTML(fullName)}</div>
              ${company ? `<div class="contact-card__company">${escapeHTML(company)}</div>` : ''}
              ${metaItems.length ? `<div class="contact-card__meta">${metaItems.join('')}</div>` : ''}
            </div>
          </div>
        `;
      }).join('');

      list.querySelectorAll('.contact-card').forEach(card => {
        card.addEventListener('click', () => openForm(card.dataset.id));
      });
    }

    document.querySelectorAll('.filter-pill').forEach(p => {
      p.addEventListener('click', () => {
        document.querySelectorAll('.filter-pill').forEach(x => x.dataset.active = 'false');
        p.dataset.active = 'true';
        currentFilter = p.dataset.filter;
        renderList();
      });
    });

    // ===========================================================
    // EXPORT VIEW
    // ===========================================================
    function renderStats() {
      document.getElementById('stat-total').textContent = contacts.length;
      document.getElementById('stat-r').textContent = contacts.filter(c => c.tag === 'R').length;
      document.getElementById('stat-n').textContent = contacts.filter(c => c.tag === 'N').length;
      document.getElementById('stat-p').textContent = contacts.filter(c => c.tag === 'P').length;
    }

    function download(filename, content, mime) {
      const blob = new Blob([content], { type: mime });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    document.getElementById('export-csv').addEventListener('click', () => {
      if (contacts.length === 0) { toast('Nothing to export'); return; }
      const headers = ['First name', 'Last name', 'Company', 'Role', 'Tag', 'Email', 'Phone', 'LinkedIn', 'Context', 'Follow-up hook', 'Captured at'];
      const rows = contacts.map(c => [
        c.firstName, c.lastName, c.company, c.role, c.tag, c.email, c.phone, c.linkedin, c.context, c.hook,
        new Date(c.createdAt).toISOString()
      ]);
      const csv = [headers, ...rows]
        .map(row => row.map(cell => {
          const s = String(cell || '');
          return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
        }).join(','))
        .join('\n');
      const stamp = new Date().toISOString().slice(0, 10);
      download(`catch-${stamp}.csv`, '\uFEFF' + csv, 'text/csv;charset=utf-8');
      toast('CSV downloaded');
    });

    document.getElementById('export-vcf').addEventListener('click', () => {
      if (contacts.length === 0) { toast('Nothing to export'); return; }
      const vcards = contacts.map(c => {
        const lines = [
          'BEGIN:VCARD',
          'VERSION:3.0',
          `N:${esc(c.lastName)};${esc(c.firstName)};;;`,
          `FN:${esc(((c.firstName||'') + ' ' + (c.lastName||'')).trim())}`,
        ];
        if (c.company) lines.push(`ORG:${esc(c.company)}`);
        if (c.role) lines.push(`TITLE:${esc(c.role)}`);
        if (c.email) lines.push(`EMAIL;TYPE=INTERNET:${c.email}`);
        if (c.phone) lines.push(`TEL;TYPE=CELL:${c.phone}`);
        if (c.linkedin) {
          const url = c.linkedin.startsWith('http')
            ? c.linkedin
            : `https://www.linkedin.com/in/${c.linkedin}`;
          lines.push(`URL:${url}`);
        }
        const note = [c.context && `Met: ${c.context}`, c.hook && `Hook: ${c.hook}`].filter(Boolean).join(' — ');
        if (note) lines.push(`NOTE:${esc(note)}`);
        lines.push('END:VCARD');
        return lines.join('\n');
      });
      const stamp = new Date().toISOString().slice(0, 10);
      download(`catch-${stamp}.vcf`, vcards.join('\n\n'), 'text/vcard');
      toast('vCards downloaded');
    });

    function esc(str) {
      return String(str || '').replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\n/g, '\\n');
    }

    // ===========================================================
    // ICS / FOLLOW-UPS
    // ===========================================================
    document.getElementById('export-followups').addEventListener('click', () => {
      if (contacts.length === 0) { toast('Nothing to schedule'); return; }
      const now = new Date();
      const target = new Date(now);
      target.setDate(target.getDate() + 2);
      target.setHours(10, 0, 0, 0);

      function fmtICS(date) {
        return date.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
      }

      const events = contacts.map((c, i) => {
        const startTime = new Date(target);
        // Spread events 5 min apart so they don't all fire at once
        startTime.setMinutes(startTime.getMinutes() + i * 5);
        const endTime = new Date(startTime);
        endTime.setMinutes(endTime.getMinutes() + 5);

        const fullName = ((c.firstName||'') + ' ' + (c.lastName||'')).trim() || 'Contact';
        const summary = `Follow up: ${fullName}${c.company ? ' (' + c.company + ')' : ''}`;
        const descParts = [];
        if (c.tag) descParts.push(`Tag: ${c.tag}`);
        if (c.role) descParts.push(`Role: ${c.role}`);
        if (c.context) descParts.push(`Met: ${c.context}`);
        if (c.hook) descParts.push(`Hook: ${c.hook}`);
        if (c.email) descParts.push(`Email: ${c.email}`);
        if (c.linkedin) {
          const url = c.linkedin.startsWith('http') ? c.linkedin : `https://www.linkedin.com/in/${c.linkedin}`;
          descParts.push(`LinkedIn: ${url}`);
        }
        if (c.phone) descParts.push(`Phone: ${c.phone}`);

        return [
          'BEGIN:VEVENT',
          `UID:${c.id}@catch.maxencedesbois`,
          `DTSTAMP:${fmtICS(now)}`,
          `DTSTART:${fmtICS(startTime)}`,
          `DTEND:${fmtICS(endTime)}`,
          `SUMMARY:${esc(summary)}`,
          `DESCRIPTION:${esc(descParts.join('\\n'))}`,
          'BEGIN:VALARM',
          'ACTION:DISPLAY',
          `DESCRIPTION:${esc(summary)}`,
          'TRIGGER:-PT0M',
          'END:VALARM',
          'END:VEVENT',
        ].join('\n');
      });

      const ics = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//Catch//Maxence Desbois//EN',
        'CALSCALE:GREGORIAN',
        ...events,
        'END:VCALENDAR',
      ].join('\n');

      const stamp = new Date().toISOString().slice(0, 10);
      download(`catch-followups-${stamp}.ics`, ics, 'text/calendar');
      toast('Calendar file ready');
    });

    document.getElementById('clear-all').addEventListener('click', () => {
      if (contacts.length === 0) { toast('Already empty'); return; }
      if (!confirm(`Permanently delete all ${contacts.length} contacts?`)) return;
      if (!confirm('Really? This cannot be undone.')) return;
      contacts = [];
      saveContacts();
      renderCapture();
      renderList();
      renderStats();
      toast('Cleared');
    });

    // ===========================================================
    // UTILS
    // ===========================================================
    function escapeHTML(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // ===========================================================
    // INIT
    // ===========================================================
    loadContacts();
    renderCapture();

  })();
  </script>

</body>
</html>
