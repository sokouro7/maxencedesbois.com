<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Catch" />
  <meta name="theme-color" content="#0A0A0A" />
  <title>Catch — by Maxence Desbois</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230A0A0A'/%3E%3Ctext x='16' y='22' font-family='Georgia,serif' font-size='18' font-weight='500' fill='%23D2691E' text-anchor='middle'%3EC%3C/text%3E%3C/svg%3E" />
  <link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'%3E%3Crect width='180' height='180' rx='40' fill='%230A0A0A'/%3E%3Ctext x='90' y='125' font-family='Georgia,serif' font-size='100' font-weight='500' fill='%23D2691E' text-anchor='middle'%3EC%3C/text%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --accent: #D2691E;
      --accent-2: #E5803A;
      --bg: #0A0A0A;
      --bg-2: #141413;
      --bg-3: #1E1D1B;
      --fg: #F5F1EA;
      --fg-2: #B8B2A7;
      --fg-3: #6B6660;
      --line: #2A2925;
      --line-2: #3A3935;

      --tag-r: #E5803A;
      --tag-n: #6BA8C4;
      --tag-p: #B8B26F;

      --font-display: 'Fraunces', 'Times New Roman', serif;
      --font-body: 'Inter', system-ui, sans-serif;
      --font-mono: 'JetBrains Mono', ui-monospace, monospace;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      background: var(--bg);
      color: var(--fg);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.5;
      min-height: 100vh;
      min-height: 100dvh;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    body {
      padding-bottom: 5.5rem;
      padding-top: env(safe-area-inset-top);
    }

    button, input, textarea, select {
      font: inherit;
      color: inherit;
    }

    button { cursor: pointer; border: none; background: none; }
    input, textarea, select {
      background: var(--bg-2);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 0.85rem 1rem;
      color: var(--fg);
      width: 100%;
      transition: border-color 0.2s ease;
      -webkit-appearance: none;
      appearance: none;
    }
    input:focus, textarea:focus, select:focus {
      outline: none;
      border-color: var(--accent);
    }
    input::placeholder, textarea::placeholder { color: var(--fg-3); }
    textarea { resize: vertical; min-height: 60px; }

    /* ============== HEADER ============== */
    .app-header {
      padding: 1rem 1.25rem 0.5rem;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      border-bottom: 1px solid var(--line);
      margin-bottom: 1.25rem;
    }
    .app-header__brand {
      font-family: var(--font-display);
      font-size: 1.55rem;
      font-weight: 500;
      letter-spacing: -0.025em;
    }
    .app-header__brand .accent { color: var(--accent); }
    .app-header__sub {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fg-3);
    }

    /* ============== TABS ============== */
    .tabbar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--bg-2);
      border-top: 1px solid var(--line);
      padding: 0.5rem 0.5rem calc(0.5rem + env(safe-area-inset-bottom));
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.25rem;
      z-index: 50;
    }
    .tabbar button {
      padding: 0.65rem 0.5rem;
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.2rem;
      color: var(--fg-3);
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transition: color 0.2s ease, background 0.2s ease;
    }
    .tabbar button.active {
      color: var(--accent);
      background: var(--bg-3);
    }
    .tabbar button svg {
      width: 22px;
      height: 22px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
    }

    /* ============== VIEWS ============== */
    .view {
      display: none;
      padding: 0 1.25rem;
    }
    .view.active { display: block; }

    /* ============== CAPTURE VIEW ============== */
    .capture-hero {
      text-align: center;
      padding: 1rem 0 1.5rem;
    }
    .capture-hero__count {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--fg-3);
      margin-bottom: 0.5rem;
    }
    .capture-hero__count strong {
      color: var(--accent);
      font-weight: 500;
    }
    .capture-hero__title {
      font-family: var(--font-display);
      font-size: 2.2rem;
      font-weight: 500;
      letter-spacing: -0.025em;
      line-height: 1.05;
      margin-bottom: 0.4rem;
    }
    .capture-hero__sub {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 400;
      font-size: 1rem;
      color: var(--fg-2);
    }

    .big-actions {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 2rem;
    }
    .big-action {
      background: var(--bg-2);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 1.5rem 1.25rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      transition: all 0.2s ease;
    }
    .big-action:active {
      background: var(--bg-3);
      transform: scale(0.99);
    }
    .big-action--primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #0A0A0A;
    }
    .big-action--primary:active {
      background: var(--accent-2);
    }
    .big-action__icon {
      flex-shrink: 0;
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: rgba(0,0,0,0.15);
      display: grid;
      place-items: center;
    }
    .big-action--primary .big-action__icon { background: rgba(0,0,0,0.18); }
    .big-action:not(.big-action--primary) .big-action__icon {
      background: var(--bg-3);
      color: var(--accent);
    }
    .big-action__icon svg {
      width: 26px;
      height: 26px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.7;
    }
    .big-action__text {
      flex: 1;
      text-align: left;
    }
    .big-action__title {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 500;
      letter-spacing: -0.015em;
      line-height: 1.15;
      margin-bottom: 0.15rem;
    }
    .big-action__sub {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      opacity: 0.7;
    }
    .big-action__arrow {
      flex-shrink: 0;
      font-size: 1.4rem;
      opacity: 0.5;
    }

    /* Last capture preview */
    .last-capture {
      background: var(--bg-2);
      border: 1px solid var(--line);
      border-left: 3px solid var(--accent);
      border-radius: 12px;
      padding: 0.85rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .last-capture__label {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--fg-3);
      margin-bottom: 0.15rem;
    }
    .last-capture__name {
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 500;
      color: var(--fg);
    }
    .last-capture__company {
      font-size: 0.85rem;
      color: var(--fg-2);
    }
    .last-capture__edit {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      padding: 0.4rem 0.6rem;
      border: 1px solid var(--accent);
      border-radius: 8px;
    }

    /* ============== FORM (MODAL) ============== */
    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.65);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 100;
      display: none;
      align-items: flex-end;
      animation: fade-in 0.2s ease;
    }
    .modal.active { display: flex; }
    .modal__sheet {
      background: var(--bg);
      width: 100%;
      max-height: 92vh;
      max-height: 92dvh;
      overflow-y: auto;
      border-radius: 24px 24px 0 0;
      padding: 1rem 1.25rem 2rem;
      padding-bottom: calc(2rem + env(safe-area-inset-bottom));
      animation: slide-up 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
      border-top: 1px solid var(--line);
    }
    @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
    @keyframes slide-up {
      from { transform: translateY(100%); }
      to { transform: translateY(0); }
    }
    .modal__handle {
      width: 40px;
      height: 4px;
      background: var(--line-2);
      border-radius: 2px;
      margin: 0 auto 1rem;
    }
    .modal__title {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 500;
      letter-spacing: -0.02em;
      margin-bottom: 0.25rem;
    }
    .modal__sub {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--fg-3);
      margin-bottom: 1.25rem;
    }

    .form-grid {
      display: grid;
      gap: 0.8rem;
    }
    .form-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }
    .field-label {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fg-3);
      margin-bottom: 0.35rem;
      display: block;
    }
    .field-label .required { color: var(--accent); }

    /* Tags selector */
    .tags-select {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }
    .tag-btn {
      padding: 0.85rem 0.5rem;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--bg-2);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transition: all 0.15s ease;
      color: var(--fg-2);
      text-align: center;
      line-height: 1.3;
    }
    .tag-btn .tag-letter {
      display: block;
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 500;
      margin-bottom: 0.1rem;
      letter-spacing: 0;
    }
    .tag-btn[data-active="true"] {
      color: #0A0A0A;
      border-color: currentColor;
    }
    .tag-btn[data-tag="R"][data-active="true"] {
      background: var(--tag-r);
      border-color: var(--tag-r);
    }
    .tag-btn[data-tag="N"][data-active="true"] {
      background: var(--tag-n);
      border-color: var(--tag-n);
    }
    .tag-btn[data-tag="P"][data-active="true"] {
      background: var(--tag-p);
      border-color: var(--tag-p);
    }

    /* Card photo */
    .photo-zone {
      position: relative;
      background: var(--bg-2);
      border: 1px dashed var(--line-2);
      border-radius: 12px;
      padding: 1.25rem;
      text-align: center;
      transition: all 0.2s ease;
      overflow: hidden;
    }
    .photo-zone__input {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
    }
    .photo-zone__placeholder {
      color: var(--fg-3);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .photo-zone__placeholder svg {
      width: 28px;
      height: 28px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.5;
      margin-bottom: 0.4rem;
      display: block;
      margin-left: auto;
      margin-right: auto;
    }
    .photo-zone--has-photo {
      padding: 0;
      border-style: solid;
    }
    .photo-zone__img {
      width: 100%;
      max-height: 240px;
      object-fit: contain;
      display: block;
      border-radius: 11px;
    }
    .photo-zone__remove {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(0,0,0,0.7);
      color: var(--fg);
      display: grid;
      place-items: center;
      font-size: 1.1rem;
      backdrop-filter: blur(4px);
    }

    /* Form actions */
    .form-actions {
      display: flex;
      gap: 0.6rem;
      margin-top: 1.5rem;
    }
    .btn {
      flex: 1;
      padding: 1rem 1rem;
      border-radius: 12px;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 500;
      transition: all 0.2s ease;
    }
    .btn--primary {
      background: var(--accent);
      color: #0A0A0A;
    }
    .btn--primary:active { background: var(--accent-2); }
    .btn--ghost {
      background: var(--bg-2);
      color: var(--fg-2);
      border: 1px solid var(--line);
    }
    .btn--ghost:active { background: var(--bg-3); }
    .btn--danger {
      color: #E66B6B;
      background: var(--bg-2);
      border: 1px solid var(--line);
    }

    /* ============== LIST VIEW ============== */
    .list-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }
    .list-title {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 500;
      letter-spacing: -0.02em;
    }
    .list-count {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fg-3);
    }
    .list-count strong {
      color: var(--accent);
      font-weight: 500;
    }

    .filters {
      display: flex;
      gap: 0.4rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }
    .filter-pill {
      padding: 0.45rem 0.85rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--bg-2);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--fg-2);
    }
    .filter-pill[data-active="true"] {
      background: var(--accent);
      color: #0A0A0A;
      border-color: var(--accent);
    }

    .contact-list {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .contact-card {
      background: var(--bg-2);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 0.9rem 1rem;
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      transition: background 0.15s ease;
    }
    .contact-card:active { background: var(--bg-3); }
    .contact-card__tag {
      flex-shrink: 0;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: grid;
      place-items: center;
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 500;
      color: #0A0A0A;
    }
    .contact-card__tag[data-tag="R"] { background: var(--tag-r); }
    .contact-card__tag[data-tag="N"] { background: var(--tag-n); }
    .contact-card__tag[data-tag="P"] { background: var(--tag-p); }
    .contact-card__tag[data-tag=""] {
      background: var(--bg-3);
      color: var(--fg-3);
      font-family: var(--font-mono);
      font-size: 0.75rem;
    }
    .contact-card__body { flex: 1; min-width: 0; }
    .contact-card__name {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 500;
      letter-spacing: -0.01em;
      line-height: 1.2;
      margin-bottom: 0.1rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .contact-card__company {
      font-size: 0.82rem;
      color: var(--fg-2);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .contact-card__meta {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--fg-3);
      margin-top: 0.3rem;
      display: flex;
      gap: 0.7rem;
      flex-wrap: wrap;
    }
    .contact-card__meta-item { display: inline-flex; align-items: center; gap: 0.25rem; }
    .contact-card__dot {
      display: inline-block;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--accent);
    }

    .empty-state {
      text-align: center;
      padding: 4rem 1rem;
    }
    .empty-state__title {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-style: italic;
      font-weight: 400;
      color: var(--fg-2);
      margin-bottom: 0.5rem;
    }
    .empty-state__sub {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fg-3);
    }

    /* ============== EXPORT VIEW ============== */
    .export-header {
      margin-bottom: 1.5rem;
    }
    .export-title {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 500;
      letter-spacing: -0.02em;
      margin-bottom: 0.3rem;
    }
    .export-sub {
      font-family: var(--font-display);
      font-style: italic;
      color: var(--fg-2);
      font-size: 1rem;
    }
    .export-stats {
      background: var(--bg-2);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 1.25rem;
      margin-bottom: 1.5rem;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
    }
    .export-stat {
      text-align: center;
    }
    .export-stat__num {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 500;
      letter-spacing: -0.02em;
      color: var(--accent);
      line-height: 1;
    }
    .export-stat__label {
      font-family: var(--font-mono);
      font-size: 0.55rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fg-3);
      margin-top: 0.25rem;
    }

    .export-actions {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .export-action {
      background: var(--bg-2);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 1.1rem 1.1rem;
      display: flex;
      align-items: center;
      gap: 0.85rem;
      text-align: left;
      transition: background 0.15s ease;
      width: 100%;
    }
    .export-action:active { background: var(--bg-3); }
    .export-action__icon {
      flex-shrink: 0;
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: var(--bg-3);
      display: grid;
      place-items: center;
      color: var(--accent);
    }
    .export-action__icon svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.7;
    }
    .export-action__text { flex: 1; }
    .export-action__title {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 500;
      letter-spacing: -0.01em;
      line-height: 1.2;
      margin-bottom: 0.1rem;
    }
    .export-action__sub {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--fg-3);
    }
    .export-action__arrow {
      font-size: 1.1rem;
      color: var(--fg-3);
    }

    .danger-zone {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--line);
    }
    .danger-zone__title {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--fg-3);
      margin-bottom: 0.75rem;
    }

    /* Toast */
    .toast {
      position: fixed;
      bottom: calc(5rem + env(safe-area-inset-bottom));
      left: 50%;
      transform: translateX(-50%) translateY(120%);
      background: var(--accent);
      color: #0A0A0A;
      padding: 0.85rem 1.4rem;
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 0.75rem;
