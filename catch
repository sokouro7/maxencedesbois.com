          <summary style="font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); padding: 0.5rem 0; cursor: pointer;">+ More fields</summary>
          <div class="form-grid" style="padding-top: 0.5rem;">
